import RPi.GPIO as GPIO
from mfrc522 import SimpleMFRC522
import requests
import time
import hashlib  # Importation pour le hachage

# --- CONFIGURATION ---
URL_VM = "http://10.96.222.141:5000/verifier_acces" 

reader = SimpleMFRC522()

print("--- LECTEUR RFID SÉCURISÉ PRÊT ---")
print("En attente d'un badge...")

try:
    while True:
        # 1. Lecture physique du badge
        id_badge, text = reader.read()
        
        # 2. HACHAGE SHA-256
        # On transforme l'ID en string, puis on le hache
        badge_uid_raw = str(id_badge).strip()
        badge_hash = hashlib.sha256(badge_uid_raw.encode()).hexdigest()
        
        print(f"\n[SCAN] Badge détecté")
        print(f"[SECURITY] Hash généré : {badge_hash[:10]}...") # On affiche juste le début pour debug

        # 3. Envoi du HASH au Flask
        try:
            payload = {"badge_uid": badge_hash} # On envoie le hash, pas l'ID en clair
            response = requests.post(URL_VM, json=payload, timeout=5)
            
            if response.status_code == 200:
                print(">> Réponse Serveur : ACCÈS OK ✅")
            elif response.status_code == 403:
                print(">> Réponse Serveur : ACCÈS REFUSÉ ❌")
            else:
                print(f">> Erreur Serveur : {response.status_code}")
                
        except Exception as e:
            print(f"!! Erreur de connexion : {e}")

        time.sleep(3)
        print("\nPrêt pour le prochain scan...")

except KeyboardInterrupt:
    print("\nArrêt du programme...")
finally:
    GPIO.cleanup()
