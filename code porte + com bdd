import RPi.GPIO as GPIO
from mfrc522 import SimpleMFRC522
import time
import requests

RELAY_PIN = 18
API_URL = "http://127.0.0.1:5000/verifier_acces"

GPIO.setmode(GPIO.BCM)
GPIO.setup(RELAY_PIN, GPIO.OUT)
GPIO.output(RELAY_PIN, GPIO.LOW)

reader = SimpleMFRC522()

print("Système prêt. Scannez un badge...")

try:
    while True:
        # Lecture physique de la carte
        id, text = reader.read()
        badge_id = str(id).strip()
        print(f"\nCarte lue : {badge_id}")

        try:
            # On demande au serveur main.py si ce badge existe en BDD
            reponse = requests.post(API_URL, json={"badge_uid": badge_id}, timeout=3)
            
            if reponse.status_code == 200:
                user = reponse.json()
                print(f"✅ ACCÈS ACCORDÉ : {user['prenom']} {user['nom']}")
                
                # Ouverture relais
                GPIO.output(RELAY_PIN, GPIO.HIGH)
                time.sleep(3)
                GPIO.output(RELAY_PIN, GPIO.LOW)
            else:
                print("❌ ACCÈS REFUSÉ : Badge inconnu dans la base utilisateurs.")
                
        except Exception as e:
            print(f"Erreur connexion API : {e}")
            
        time.sleep(1)

except KeyboardInterrupt:
    print("Arrêt.")
finally:
    GPIO.cleanup()
