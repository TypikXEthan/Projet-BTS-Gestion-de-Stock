import RPi.GPIO as GPIO
import time

RELAY_PIN = 18 # GPIO 18 / Pin 12
GPIO.setmode(GPIO.BCM)
GPIO.setup(RELAY_PIN, GPIO.OUT)

try:
    print("Test du relais : ON")
    GPIO.output(RELAY_PIN, GPIO.HIGH) # Essaye HIGH
    time.sleep(2)
    print("Test du relais : OFF")
    GPIO.output(RELAY_PIN, GPIO.LOW)
    time.sleep(2)
    
    print("Test inverse (pour relais Active Low) : ON")
    GPIO.output(RELAY_PIN, GPIO.LOW) # Essaye LOW
    time.sleep(2)
    GPIO.output(RELAY_PIN, GPIO.HIGH)
    
finally:
    GPIO.cleanup()
